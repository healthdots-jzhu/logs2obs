<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CA1848;CA1873;CA1725;CA1305;CA2012</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Logs2Obs.Core\Logs2Obs.Core.csproj" />
    <ProjectReference Include="..\Logs2Obs.Adapters.Local\Logs2Obs.Adapters.Local.csproj" />
    <ProjectReference Include="..\Logs2Obs.Worker\Logs2Obs.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Quartz" Version="3.13.*" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.13.*" />
    <PackageReference Include="Polly" Version="8.*" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.*" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.*" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
  </ItemGroup>
  <!-- Logs2Obs.Worker is referenced for its compiled types only; its own appsettings.json
       would otherwise collide with this project's during publish (NETSDK1152). -->
  <Target Name="ExcludeTransitiveWorkerAppSettings" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="$([System.String]::new('%(Filename)').StartsWith('appsettings')) and $([System.String]::new('%(FullPath)').Contains('Logs2Obs.Worker'))" />
    </ItemGroup>
  </Target>
</Project>
